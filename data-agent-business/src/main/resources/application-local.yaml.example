# 复制为 application-local.yaml 并填入真实值。application-local.yaml 已被 .gitignore
# 忽略，禁止提交。主 application.yaml 只有占位符。
#
# 切换模型供应商只需改下面三项，不动 Java 代码（OpenAI 兼容协议）。

spring:
  ai:
    openai:
      # DeepSeek：代码生成能力强、单价低；Token 消耗大头在代码生成与自修复重试
      base-url: https://api.deepseek.com
      api-key: sk-your-key-here
      chat:
        completions-path: /v1/chat/completions
        options:
          model: deepseek-chat

  datasource:
    username: root
    password: your-mysql-password

# 智谱 GLM（备用，切换时替换上面 openai 段）：
#   base-url: https://open.bigmodel.cn
#   api-key: your-key-here
#   chat:
#     completions-path: /api/paas/v4/chat/completions   # 注意路径与 DeepSeek 不同
#     options:
#       model: glm-4-plus
